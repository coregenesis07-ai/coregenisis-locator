{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coregenisis-v2-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coregenisis-v2-preview-db",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "REPLACE_WITH_PREVIEW_WORKERS_DEV_ORIGIN",
    "PUBLIC_SITE_URL": "REPLACE_WITH_PREVIEW_WORKERS_DEV_ORIGIN",
    "ALERT_FROM_EMAIL": "REPLACE_WITH_VERIFIED_PREVIEW_SENDER",
    "PREVIEW_MODE": "1"
  },
  "triggers": {
    "crons": ["0 10 * * *", "30 10 * * 0"]
  }
}
