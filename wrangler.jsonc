{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "federalcustodyguide-search",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ALERTS_ENABLED": "false"
  },
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
