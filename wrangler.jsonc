{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "federalcustodyguide-search",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ALERTS_ENABLED": "false"
  },
  "previews": {
    "vars": {
      "ALERTS_ENABLED": "false"
    }
  }
}
