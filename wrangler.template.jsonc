{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coregenisis-v2",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coregenisis-db",
      "database_id": "REPLACE_WITH_EXISTING_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "REPLACE_WITH_PRODUCTION_ORIGIN"
  },
  "triggers": {
    "crons": ["0 10 * * *", "30 10 * * 0"]
  }
}
